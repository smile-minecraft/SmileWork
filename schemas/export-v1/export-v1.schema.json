{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smilework:export:v1",
  "title": "SmileWork export v1",
  "description": "manifest.json 與各 JSONL 記錄的結構定義。raw/ 的位元組內容不在 JSON Schema 範圍內，由套件驗證程式檢查。",
  "$ref": "#/$defs/manifest",
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "formatVersion",
        "createdAt",
        "producer",
        "source",
        "layout",
        "warnings"
      ],
      "properties": {
        "format": {
          "type": "string",
          "const": "smilework-export"
        },
        "formatVersion": {
          "type": "integer",
          "const": 1
        },
        "createdAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "layout": {
          "$ref": "#/$defs/manifestLayout"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "smilework"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "projectId",
        "layers"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "ultrawork-v3",
            "smilework-db"
          ]
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "projectPath": {
          "type": "string",
          "minLength": 1
        },
        "registryVersion": {
          "type": "string",
          "minLength": 1
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/layer"
          }
        }
      }
    },
    "manifestLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "work",
        "events",
        "evidence",
        "signals",
        "knowledge",
        "mapping",
        "raw"
      ],
      "properties": {
        "manifest": {
          "$ref": "#/$defs/layoutManifest"
        },
        "work": {
          "$ref": "#/$defs/layoutWork"
        },
        "events": {
          "$ref": "#/$defs/layoutEvents"
        },
        "evidence": {
          "$ref": "#/$defs/layoutEvidence"
        },
        "signals": {
          "$ref": "#/$defs/layoutSignals"
        },
        "knowledge": {
          "$ref": "#/$defs/layoutKnowledge"
        },
        "mapping": {
          "$ref": "#/$defs/layoutMapping"
        },
        "raw": {
          "$ref": "#/$defs/layoutRaw"
        }
      }
    },
    "layoutManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "const": "manifest.json"
        }
      }
    },
    "layoutWork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "records"
      ],
      "properties": {
        "path": {
          "type": "string",
          "const": "work.jsonl"
        },
        "records": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "layoutEvents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "records"
      ],
      "properties": {
        "path": {
          "type": "string",
          "const": "events.jsonl"
        },
        "records": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "layoutEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "records"
      ],
      "properties": {
        "path": {
          "type": "string",
          "const": "evidence.jsonl"
        },
        "records": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "layoutSignals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "records"
      ],
      "properties": {
        "path": {
          "type": "string",
          "const": "signals.jsonl"
        },
        "records": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "layoutKnowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "entries",
        "files"
      ],
      "properties": {
        "path": {
          "type": "string",
          "const": "knowledge/"
        },
        "entries": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "layoutMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "records"
      ],
      "properties": {
        "path": {
          "type": "string",
          "const": "mapping.jsonl"
        },
        "records": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "layoutRaw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "files",
        "projectFiles",
        "globalFiles"
      ],
      "properties": {
        "path": {
          "type": "string",
          "const": "raw/"
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "projectFiles": {
          "type": "integer",
          "minimum": 0
        },
        "globalFiles": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "blocked",
        "review",
        "done",
        "cancelled"
      ]
    },
    "terminalStatus": {
      "type": "string",
      "enum": [
        "done",
        "cancelled"
      ]
    },
    "resolution": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "abandoned"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:raw/(?:project|global)|knowledge)/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      }
    },
    "url": {
      "type": "string",
      "pattern": "^https?://\\S+$"
    },
    "workRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workId",
        "kind",
        "title",
        "status",
        "owner",
        "priority"
      ],
      "properties": {
        "workId": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "enum": [
            "task",
            "plan"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "planId": {
          "$ref": "#/$defs/identifier"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "nonGoals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "contextRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativeRef"
          }
        },
        "scopePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativeRef"
          }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict",
            "reviewer"
          ],
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "approve",
                "concerns",
                "reject"
              ]
            },
            "reviewer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "note": {
              "type": "string",
              "maxLength": 4000
            },
            "reworkedAfterReview": {
              "type": "boolean"
            }
          }
        },
        "acceptanceResults": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recordedBy",
            "items"
          ],
          "properties": {
            "recordedBy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "criterion",
                  "met"
                ],
                "properties": {
                  "criterion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "met": {
                    "type": "boolean"
                  },
                  "evidence": {
                    "type": "string",
                    "maxLength": 4000
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "$ref": "#/$defs/terminalStatus"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "resolution"
            ],
            "properties": {
              "resolution": {
                "$ref": "#/$defs/resolution"
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "resolution": false
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "const": "done"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "resolution": {
                "type": "string",
                "enum": [
                  "completed",
                  "failed"
                ]
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "const": "cancelled"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "resolution": {
                "type": "string",
                "const": "abandoned"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "acceptanceResults"
            ],
            "properties": {
              "acceptanceResults": {
                "type": "object"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "acceptance"
            ],
            "properties": {
              "acceptance": {
                "type": "array"
              }
            }
          }
        }
      ]
    },
    "eventRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "sequence",
        "kind",
        "actor"
      ],
      "properties": {
        "eventId": {
          "$ref": "#/$defs/identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "created",
            "status_changed",
            "reviewed",
            "verified",
            "evidence_added",
            "signal_recorded",
            "knowledge_written",
            "note"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "workId": {
          "$ref": "#/$defs/identifier"
        },
        "fromStatus": {
          "$ref": "#/$defs/status"
        },
        "toStatus": {
          "$ref": "#/$defs/status"
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        },
        "summary": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "const": "status_changed"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "toStatus"
            ],
            "properties": {
              "toStatus": {
                "$ref": "#/$defs/status"
              }
            }
          }
        }
      ]
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "workId",
        "kind",
        "actor",
        "summary"
      ],
      "properties": {
        "evidenceId": {
          "$ref": "#/$defs/identifier"
        },
        "workId": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string",
          "enum": [
            "command",
            "test",
            "review",
            "link",
            "note",
            "artifact"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "path": {
          "$ref": "#/$defs/packagePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "details": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "command",
                  "test"
                ]
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "command"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "const": "link"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "$ref": "#/$defs/url"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "const": "artifact"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/packagePath"
              }
            }
          }
        }
      ]
    },
    "signalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signalId",
        "severity",
        "code",
        "message"
      ],
      "properties": {
        "signalId": {
          "$ref": "#/$defs/identifier"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "workId": {
          "$ref": "#/$defs/identifier"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "knowledgeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledgeId",
        "type",
        "layer",
        "title",
        "description",
        "pinned",
        "source",
        "versions",
        "currentVersion"
      ],
      "properties": {
        "knowledgeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "enum": [
            "decision",
            "reference",
            "lesson",
            "pitfall",
            "preference",
            "document"
          ]
        },
        "layer": {
          "type": "string",
          "enum": [
            "project",
            "global"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "pinned": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/knowledgeVersion"
          }
        },
        "currentVersion": {
          "type": "integer",
          "minimum": 1
        },
        "workId": {
          "$ref": "#/$defs/identifier"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "knowledgeVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string",
          "pattern": "^knowledge/files/[A-Za-z0-9][A-Za-z0-9._-]*/v[1-9][0-9]*\\.md$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "mappingRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "layer",
        "sourceRoot",
        "sourceId",
        "targetId",
        "sourceRef"
      ],
      "properties": {
        "entity": {
          "type": "string",
          "enum": [
            "work",
            "event",
            "evidence",
            "signal",
            "knowledge",
            "raw"
          ]
        },
        "layer": {
          "$ref": "#/$defs/layer"
        },
        "sourceRoot": {
          "$ref": "#/$defs/sourceRoot"
        },
        "sourceId": {
          "$ref": "#/$defs/relativeRef"
        },
        "sourceRecord": {
          "$ref": "#/$defs/sourceRecord"
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sourceRef": {
          "$ref": "#/$defs/relativeRef"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "layer"
            ],
            "properties": {
              "layer": {
                "const": "project"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "sourceRoot": {
                "const": "raw/project"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "layer"
            ],
            "properties": {
              "layer": {
                "const": "global"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "sourceRoot": {
                "const": "raw/global"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "sourceRoot"
            ],
            "properties": {
              "sourceRoot": {
                "const": "raw/project"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "sourceRef": {
                "type": "string",
                "pattern": "^raw/project/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
                "not": {
                  "pattern": "(^|/)\\.\\.(/|$)"
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "sourceRoot"
            ],
            "properties": {
              "sourceRoot": {
                "const": "raw/global"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "sourceRef": {
                "type": "string",
                "pattern": "^raw/global/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
                "not": {
